#!/bin/bash
# Gas validation pack test 3: pore-pressure decay in a suddenly loaded
# fine-powder column against Terzaghi (WP F.3). Runs on 1, 2 and 4
# processors, checks them against the series and each other, writes
# times.csv and results.md. About 1.5 min.
cd "$(dirname "$0")" || exit 1
[ -n "${WM_PROJECT_DIR:-}" ] || { echo "Load OpenFOAM first: source /usr/lib/openfoam/openfoam2512/etc/bashrc"; exit 1; }
python3 terzaghi_column.py run
