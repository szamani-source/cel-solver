#!/usr/bin/env python3
"""celCheck: check a celFoam case's mesh before a run.

    celCheck CASE_DIR [--png FILE] [--json FILE]

Reports the time step (as celFoam computes it) and the cell that sets it,
cell sizes at the outlet and walls against the grain size and the nonlocal
length, non-orthogonality, size jumps and the estimated run time. Exit code
0 PASS, 1 WARN, 2 FAIL. --png draws the mesh coloured by cell size (needs
matplotlib); --json writes the numbers (used by the setup GUI).
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from celsetup import check  # noqa: E402


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    opts = {}
    args = []
    it = iter(argv)
    for a in it:
        if a in ("--png", "--json"):
            opts[a] = next(it)
        else:
            args.append(a)
    try:
        res, m = check.run_check(args[0])
    except (ValueError, OSError) as e:
        print(f"celCheck: {e}", file=sys.stderr)
        return 3
    text, worst = check.report(res)
    print(text)
    if "--json" in opts:
        with open(opts["--json"], "w") as f:
            json.dump(res, f)
    if "--png" in opts:
        try:
            check.picture(res, m, opts["--png"])
            print(f"  picture: {opts['--png']}")
        except ImportError:
            print("  (no picture: matplotlib is not installed)")
    return {"PASS": 0, "WARN": 1, "FAIL": 2}[worst]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
