#!/bin/bash
# Couto et al. (2013) wheat silo with a conical hopper, on the axisymmetric wedge:
# the validation case of celFoam 1.0 (decisions 0100, 0107, 0115, 0117).
#
#   ./Allrun [mc|dp] [mesh|mesh-fine|standard|fine]
#
#   mesh       build the standard mesh and STL shell only, checkMesh, mesh.png (seconds)
#   mesh-fine  the same for the fine mesh
#   standard   25 mm upper cylinder rows (about 8,000 cells), about 2 h on 4 cores (default)
#   fine       the validated 4 mm mesh (20,398 cells, outlet 3.1 mm), about 8 h on 4 cores
#
# mc = Mohr-Coulomb (default), dp = Drucker-Prager (plane-strain fit).
# Environment: CEL_NPROCS (MPI ranks, default 4).
# The case is built in ./run/couto_<model>_aligned_buffered and run with celVoidCheck.
# The report (discharge rate, wall pressures against the experiment, leak check) goes
# to ./run/<model>.out. It checkpoints every 0.05 s of simulated time: if a run is
# stopped, ./Allrun with the same arguments resumes from the latest checkpoint.
cd "${0%/*}" || exit 1
root="${CELFOAM_DIR:-$(cd ../../.. && pwd)}"
hop="$root/tests/hopper"
[ -f "$hop/hopper_pressure_checks.py" ] || { echo "cannot find $hop; load the celFoam environment" >&2; exit 1; }
command -v celVoidCheck > /dev/null || { echo "celVoidCheck not found; load the celFoam environment (celfoam)" >&2; exit 1; }

model="${1:-mc}"
level="${2:-standard}"
case "$model" in mc|dp) ;; *) echo "model must be mc or dp" >&2; exit 1 ;; esac
work="$PWD/run"
mkdir -p "$work"

export CEL_NPROCS="${CEL_NPROCS:-4}"
case "$level" in
    fine|mesh-fine)
        # decision 0117: 58 columns (16 mm at the axis to 4 mm at the wall), 4 mm rows
        # in the hopper, 12 mm rows above, outlet columns 3.1 to 3.2 mm
        export CEL_H_TOP=0.012 CEL_NCOLS=58 CEL_WALL_RATIO=0.25 CEL_H_HOP=0.004 \
               CEL_OUTLET_WALL_RATIO=1.0
        ;;
    standard|mesh) ;;
    *) echo "level must be mesh, mesh-fine, standard or fine" >&2; exit 1 ;;
esac
export CEL_DP_FIT=plane_strain
export CEL_CHECKPOINT=0.05 CEL_RESUME=1
# wheat mu(I) (decision 0102), T0 rules, fullBlend, nonlocal fluidity (decision 0111)
export CEL_HOPPER_RULES="$(printf 'mu2 0.8412;\nI0 0.279;\nd 0.004;\nrhoS 1380;\nshearCap yes;\nspreadLayers yes;\nflowImpedance yes;\nnormalCap yes;\nfullBlend yes;\nnonlocalA 0.48;\n')"

if [ "${level#mesh}" != "$level" ]; then
    python3 - "$hop" "$work" "$model" <<'PY'
import os, subprocess, sys
hop, work, model = sys.argv[1:4]
sys.path.insert(0, hop)
import buffered_case as bc
import hopper_pressure_checks as hpc
e = os.environ
h_top = float(e.get("CEL_H_TOP", 0.025))
kw = dict(h_top=h_top, head_rows=int(round(3 * 0.025 / h_top)),
          ncols=int(e.get("CEL_NCOLS", 44)), wall_ratio=float(e.get("CEL_WALL_RATIO", 0.6)),
          h_hop=float(e.get("CEL_H_HOP", 0.012)))
if "CEL_OUTLET_WALL_RATIO" in e:
    kw["outlet_wall_ratio"] = float(e["CEL_OUTLET_WALL_RATIO"])
check = dict(tEnd=hpc.T_END, maxCo=0.4, writeTimes=hpc.WRITES, tOpen=hpc.T_OPEN)
p, c = bc.aligned_buffered_case(work, f"couto_{model}_mesh", model, check, **kw)
for cmd in (["blockMesh"], ["checkMesh"]):
    with open(f"{p}/log.{cmd[0]}", "w") as f:
        subprocess.run(cmd, cwd=p, stdout=f, stderr=subprocess.STDOUT)
log = open(f"{p}/log.checkMesh").read()
print(log.split("Checking topology")[0].split("Mesh stats")[-1].strip())
print("Mesh OK" if "Mesh OK" in log else "checkMesh reports problems: see " + p + "/log.checkMesh")
try:
    bc.picture(p, c, os.path.join(os.path.dirname(work), "mesh.png"))
    print("mesh picture: mesh.png")
except Exception as err:   # matplotlib missing
    print("no picture (" + str(err) + ")")
print("case: " + p)
PY
    exit $?
fi

echo "Couto silo, $model, $level mesh, $CEL_NPROCS ranks: report in run/$model.out"
python3 "$hop/hopper_pressure_checks.py" "$work" "$model" aligned_buffered 2>&1 | tee "$work/$model.out"
