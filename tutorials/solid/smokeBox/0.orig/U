FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

// Velocity [m/s]. Optional: if this file is absent, celFoam creates U = 0
// with zeroGradient patches. sigma, epsP and epsPEq are created the same way
// (zero) unless a file is given.

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    walls
    {
        type    fixedValue;
        value   uniform (0 0 0);
    }
}
