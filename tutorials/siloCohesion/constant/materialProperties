// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          materialProperties;
}

rho             1800;

freeSurface     yes;

type            mohrCoulomb;

E               1e+07;

nu              0.3;

phi             35;

// Cohesion [Pa] (WP 3.5, decision 0054). The tensile strength is c cot(phi)
// unless sigmaT is given; cohesive material carries tension up to it at
// contact faces and tears (opens void) beyond it.
c               500;

psi             0;

mu2             0.961813;

I0              0.279;

d               0.001;

rhoS            2650;

shearCap        yes;

spreadLayers    yes;

flowImpedance   yes;

// Normal Riemann jump capped at yield (rule 12, decision 0035); part of the
// T0 rule set with mu(I) and flowImpedance (decision 0050)
normalCap       yes;

walls
{
    left
    {
        friction        20;
    }
    right
    {
        friction        20;
    }
    bottom
    {
        friction        20;
    }
    top
    {
        friction        0;
    }
}

outlets
{
    outlet
    {
        friction        20;
        openTime        0.3;
    }
}


