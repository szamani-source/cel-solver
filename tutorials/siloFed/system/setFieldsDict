/*--------------------------------*- C++ -*----------------------------------*\
  celFoam tutorial siloDischarge (WP 3.6d)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// Stress-free fill of the tank to H = 0.6 m (whole cells at 10 and 5 mm);
// the 10 cells above it, up to the lid with the inlet, are void.
defaultFieldValues
(
    volScalarFieldValue alpha 0
    volScalarFieldValue rho 0
);
regions
(
    boxToCell
    {
        box (-1 -1 -1) (1 0.6 1);
        fieldValues
        (
            volScalarFieldValue alpha 1
            volScalarFieldValue rho 1800
        );
    }
);
