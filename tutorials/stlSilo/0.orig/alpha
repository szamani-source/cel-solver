  celFoam tutorial siloDischarge (WP 3.6d)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha;
}
// Material volume fraction (0 void, 1 full). setFields fills the tank to 0.6 m above its floor; alpha is the fraction of the open (not STL-covered) volume.

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    ".*"
    {
        type    zeroGradient;
    }
    frontAndBack
    {
        type    empty;
    }
}
