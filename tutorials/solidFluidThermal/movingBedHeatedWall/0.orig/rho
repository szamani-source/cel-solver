FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      rho;
}

dimensions [1 -3 0 0 0 0 0];
internalField uniform 2090.0;
boundaryField
{
    inlet { type zeroGradient;  }
    outlet { type zeroGradient;  }
    wall { type zeroGradient;  }
    mid { type zeroGradient;  }
    frontAndBack { type empty; }
}
