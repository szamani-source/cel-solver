#!/bin/sh
# Air-impeded discharge of fine sand from a plane-flow hopper (WP F.5,
# decision 0130; tutorial WP F.9). Runs the case with gas, then the same
# hopper without gas in dry/ for comparison.
#   ./Allrun            # 0.2 mm grains, about 2 minutes for both runs
#   ./Allrun 0.1        # grain diameter in mm (1 mm: the gas hardly acts;
#                       # 0.1 mm: the lift check warns, see README)
#   ./Allrun 0.2 2      # on 2 processors
# Then: python3 plot.py   (needs numpy and matplotlib)
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

d_mm="${1:-0.2}"
nProcs="${2:-1}"
d=$(awk "BEGIN { print $d_mm/1000 }")
# sed keeps the comments of the dictionaries
sed -i "s/^d  *[0-9.eE+-]*;/d            $d;/" constant/gasProperties constant/materialProperties

# dry/: the same case without constant/gasProperties
rm -rf dry
mkdir dry
cp -r 0.orig constant system dry/
rm dry/constant/gasProperties

for case in . dry
do
    (
        cd "$case" || exit
        restore0Dir
        runApplication blockMesh
        runApplication setFields
        if [ "$nProcs" -gt 1 ]
        then
            foamDictionary -entry numberOfSubdomains -set "$nProcs" system/decomposeParDict > /dev/null
            foamDictionary -entry coeffs.n -set "($nProcs 1 1)" system/decomposeParDict > /dev/null
            runApplication decomposePar
            runParallel celFoam
            runApplication reconstructPar
        else
            runApplication celFoam
        fi
    )
done
