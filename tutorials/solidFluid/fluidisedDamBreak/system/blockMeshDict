FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// Channel 3 m long and 0.45 m high, one cell deep; ./Allrun <cell in mm>
// sets the cell counts (10 mm: 300 x 45)
scale 1;
vertices ((0 0 0) (3.0 0 0) (3.0 0.45 0) (0.0 0.45 0) (0 0 0.01) (3.0 0 0.01) (3.0 0.45 0.01) (0.0 0.45 0.01));
blocks (hex (0 1 2 3 4 5 6 7) (300 45 1) simpleGrading (1 1 1));
boundary
(
    left { type patch; faces ((0 4 7 3)); }
    right { type patch; faces ((1 2 6 5)); }
    bottom { type patch; faces ((0 1 5 4)); }
    top { type patch; faces ((3 7 6 2)); }
    frontAndBack { type empty; faces ((0 3 2 1) (4 5 6 7)); }
);
