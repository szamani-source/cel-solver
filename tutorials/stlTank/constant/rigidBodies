FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      rigidBodies;
}
// STL walls (WP 4.1, 4.3a): closed surfaces with outward normals in
// constant/triSurface, fixed (no velocity or omega), acting on the material
// as cut-cell walls (decision 0047). friction: wall friction angle [deg] of
// the material on the body (default 0, smooth). The lid is smooth: the
// settling material leaves it, so it acts as a free top (no void here; the
// mesh outside the tank must be covered by bodies).
bodies
{
    leftWall
    {
        surface leftWall.stl;
        friction 20.0;
    }
    rightWall
    {
        surface rightWall.stl;
        friction 20.0;
    }
    bottomWall
    {
        surface bottomWall.stl;
        friction 20.0;
    }
    lid
    {
        surface lid.stl;
        friction 0.0;
    }
}
