FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      rho;
}
// Cell density [kg/m^3] = alpha * rho of the material. setFields: 1800 in the fill.

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    ".*"
    {
        type    zeroGradient;
    }
    frontAndBack
    {
        type    empty;
    }
}
