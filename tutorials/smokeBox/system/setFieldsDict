FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

// Non-uniform start (WP 2.1): the half x < 0.5 m is denser and moves at
// 1 m/s in x. Total mass 0.5*1800 + 0.5*2000 = 1900 kg, momentum
// (1000 0 0) kg m/s. Used by Allrun and tests/test_eulerian_skeleton.sh.

defaultFieldValues
(
    volScalarFieldValue rho 1800
    volVectorFieldValue U (0 0 0)
);

regions
(
    boxToCell
    {
        box (-1 -1 -1) (0.5 2 2);
        fieldValues
        (
            volScalarFieldValue rho 2000
            volVectorFieldValue U (1 0 0)
        );
    }
);
