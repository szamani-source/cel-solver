FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      materialProperties;
}

// Soft soil-like elastic material for the smoke test
//
// type: constitutive model (library celConstitutive, WP 2.2). Choices:
//   linearElastic   needs E, nu
//   vonMises        needs E, nu, sigma_y [Pa]; optional H [Pa] (linear
//                   isotropic hardening modulus, default 0)
// rho: density used where no 0/rho file is given (eulerianSolid, WP 2.1).
// The stable time step uses the model's wave modulus K + 4G/3 and the cell
// density.

type    linearElastic;

rho     1800;      // kg/m^3
E       1e7;       // Pa
nu      0.3;
