FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      rigidBodies;
}

// Rigid bodies (WP 4.1, decision 0041). Each body is a closed or open
// triangulated surface in constant/triSurface (STL, OBJ, ... by extension),
// given in its pose at time zero, with a prescribed motion:
//
//   surface   <file>;          required
//   centre    (x y z);         reference point the body rotates about and
//                              whose velocity is given [m]; default: the
//                              area-weighted centroid of the surface
//   velocity  <Function1>;     velocity of the centre [m/s]; default zero
//   omega     <Function1>;     angular velocity [rad/s]; default zero
//
// velocity and omega are OpenFOAM Function1<vector>s of time: constant,
// table, sine, square, ... (any type that can be integrated). Position is
// the exact integral of velocity; rotation is exact while the axis of
// omega stays fixed. A body without velocity and omega is a fixed wall.
// Bodies move but exert no force yet (contact: WP 4.2, 4.3).
//
// Rough walls (WP 4.3e, decision 0059): "adhesion <Pa>;" adds a wall shear
// strength at zero pressure to the friction (a fully rough wall in clay:
// adhesion cu). The material still separates from the wall in tension.
//
// Free bodies (WP 4.3d, decision 0058): give a mass (kg, of the part the
// mesh holds) and the motion follows from the force of the material and
// gravity; velocity and omega are then initial values (plain vectors), and
// an optional inertia (symmTensor, kg m^2, about the centre at time zero)
// lets it rotate:
//
//     block { surface block.stl; mass 0.75; inertia (1e-3 0 0 1e-3 0 1e-3);
//             velocity (0 0 0); }
//
// Deformable bodies (WP 5.3a, decision 0072): a box of hex8 elements in
// place of the STL; nodes in the drive box follow velocity, the rest move
// under gravity and the material (needs freeSurface yes to couple):
//
//     footing { deformable { min (0.1 0.15 -0.01); max (0.2 0.25 0.02);
//               cells (10 10 1); density 7800; planeStrain yes; damping 0.2;
//               material { type linearElastic; E 2e11; nu 0.3; }
//               drive (0.09 0.249 -1) (0.21 0.251 1); }
//               velocity constant (0 -0.25 0); friction 20; }
//
// Output: postProcessing/rigidBodies/<name>.dat (t, centre, rotation, v,
// omega at write times) and postProcessing/rigidBodies/<time>/<name>.stl.

bodies
{
    // Fixed inclined wall (hopper side), 45 degrees
    hopperWall
    {
        surface     hopperWall.stl;
    }

    // Pushed down: velocity ramps from 0 to 1 m/s over 5 ms, then constant
    pusher
    {
        surface     cube.stl;
        velocity    table
        (
            (0      (0 0 0))
            (0.005  (0 0 -1))
            (1      (0 0 -1))
        );
    }

    // Translates along x and spins about the vertical edge through
    // (0.4 0.4 z) at 100 rad/s
    spinner
    {
        surface     cube.stl;
        centre      (0.4 0.4 0.7);
        velocity    constant (0.5 0 0);
        omega       constant (0 0 100);
    }
}
