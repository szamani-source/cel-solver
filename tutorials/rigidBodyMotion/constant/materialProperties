FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      materialProperties;
}

// Soft soil-like elastic material; the bodies do not touch it yet (WP 4.1)
//
// type: constitutive model (library celConstitutive, WP 2.2). Choices:
//   linearElastic   needs E, nu
//   vonMises        needs E, nu, sigma_y [Pa]; optional H [Pa] (linear
//                   isotropic hardening modulus, default 0)
//   druckerPrager   needs E, nu, phi [deg], c [Pa], psi [deg] (WP 2.5a);
//                   optional fit (word): compression (outer cone, default),
//                   extension (inner cone) or plane_strain match to
//                   Mohr-Coulomb. Perfectly plastic, non-associated (psi).
//                   Example: phi 30; c 10e3; psi 5; fit compression;
//   mohrCoulomb     needs E, nu, phi [deg], c [Pa], psi [deg] (WP 2.5b);
//                   optional sigmaT [Pa]: tensile strength (Rankine tension
//                   cut-off, WP 2.5c), 0 <= sigmaT <= c cot(phi); without it
//                   cohesive material carries tension up to c cot(phi).
//                   Example: phi 30; c 10e3; psi 5; sigmaT 5e3;
// rho: density used where no 0/rho file is given (eulerianSolid, WP 2.1).
// The stable time step uses the model's wave modulus K + 4G/3 and the cell
// density.
// remapLimiters (optional, WP 2.4): slope limiter of the remap per field,
//   upwind, minmod, MC or superbee. Defaults (decision 0013 item 5):
//   remapLimiters { rho MC; U MC; sigma MC; epsP superbee; epsPEq superbee; }

type    linearElastic;

rho     1800;      // kg/m^3
E       1e7;       // Pa
nu      0.3;

// Optional mu(I) friction for druckerPrager and mohrCoulomb (WP 3.6a, decision
// 0037; with mu2 absent or equal to tan(phi) the models are rate-independent):
//   mu2       0.9618;   // friction at large I [-] (mu_s = tan(phi))
//   I0        0.279;    // inertial number scale [-]
//   d         1e-3;     // grain diameter [m]
//   rhoS      2650;     // grain density [kg/m^3]
//   muIAlpha  1.9;      // Barker-Gray regularisation, only where it exists
