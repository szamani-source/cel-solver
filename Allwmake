#!/bin/sh
# Build everything in this repository. Needs an OpenFOAM v2512 environment.
cd "${0%/*}" || exit
set -e
wmake libso src/celConstitutive
wmake libso src/celEulerian
wmake libso src/celLagrangian
wmake libso src/celCoupling
wmake applications/solvers/celFoam
wmake applications/utilities/celBodyCells
